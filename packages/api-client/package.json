{
  "name": "@iridium/api-client",
  "version": "0.2.0",
  "private": true,
  "description": "openapi-fetch client over generated types; ApiTransport (FetchTransport, IpcTransport); TicketSource; typed ProblemDetails errors",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "test": "vitest --run --passWithNoTests --config ../../vitest.config.ts --project unit packages/api-client",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@iridium/contracts": "workspace:*",
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "@iridium/tsconfig": "workspace:*"
  }
}
