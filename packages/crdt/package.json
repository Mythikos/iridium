{
  "name": "@iridium/crdt",
  "version": "0.2.0",
  "private": true,
  "description": "the only first-party package importing yjs, y-protocols and lib0 (note doc factory, V1/V2 codec, dominates, prefixSuffixDiff, guards)",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "test": "vitest --run --passWithNoTests --config ../../vitest.config.ts --project unit packages/crdt",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@iridium/contracts": "workspace:*",
    "lib0": "catalog:",
    "y-protocols": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@fast-check/vitest": "catalog:",
    "@iridium/tsconfig": "workspace:*",
    "fast-check": "catalog:",
    "vitest": "catalog:"
  }
}
