{
  "name": "@iridium/mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "iridium-mcp: stdio ⇄ Streamable HTTP transparent proxy (SDK v2 server + client); bundled into desktop resources",
  "bin": {
    "iridium-mcp": "./dist/iridium-mcp.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "test": "vitest --run --passWithNoTests --config ../../vitest.config.ts --project unit packages/mcp-bridge",
    "test:contract": "vitest --run --passWithNoTests --config ../../vitest.config.ts --project contract packages/mcp-bridge",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@iridium/contracts": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:"
  },
  "devDependencies": {
    "@iridium/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  }
}
