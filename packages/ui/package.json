{
  "name": "@iridium/ui",
  "version": "0.0.0",
  "private": true,
  "description": "the whole React application plus the IridiumHost seam, the commands registry and i18n/en.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "test": "vitest --run --passWithNoTests --config ../../vitest.config.ts --project unit packages/ui",
    "test:component": "vitest --run --passWithNoTests --config ../../vitest.config.ts --project component packages/ui"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@base-ui/react": "catalog:",
    "@headless-tree/core": "catalog:",
    "@headless-tree/react": "catalog:",
    "@iridium/api-client": "workspace:*",
    "@iridium/collab-client": "workspace:*",
    "@iridium/contracts": "workspace:*",
    "@iridium/editor": "workspace:*",
    "@iridium/markdown": "workspace:*",
    "@iridium/markdown-react": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "catalog:",
    "tailwindcss": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@iridium/tsconfig": "workspace:*"
  }
}
