{
  "name": "@iridium/collab-client",
  "version": "0.0.0",
  "private": true,
  "description": "NoteSession, NoteSessionRegistry, SaveStateMachine, VaultChannel client, stateless message codec, WebSocket injection",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "test": "vitest --run --passWithNoTests --config ../../vitest.config.ts --project unit packages/collab-client",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@hocuspocus/common": "catalog:",
    "@hocuspocus/provider": "catalog:",
    "@iridium/contracts": "workspace:*",
    "@iridium/crdt": "workspace:*"
  },
  "devDependencies": {
    "@fast-check/vitest": "catalog:",
    "@iridium/tsconfig": "workspace:*",
    "fast-check": "catalog:",
    "vitest": "catalog:"
  }
}
