{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@iridium/tsconfig/node.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedDeclarations": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx"],
  "references": [
    {
      "path": "../contracts/tsconfig.build.json"
    },
    {
      "path": "../crdt/tsconfig.build.json"
    },
    {
      "path": "../api-client/tsconfig.build.json"
    },
    {
      "path": "../collab-client/tsconfig.build.json"
    }
  ]
}
