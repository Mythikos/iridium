{
  "name": "@iridium/testkit",
  "version": "0.1.0",
  "private": true,
  "description": "the single harness entry point: startTestEnv, startServer, NoteClient, restClient, toMatchOpenApi, Toxiproxy helpers, fault constants, fixtures (dev only)",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "test": "vitest --run --passWithNoTests --config ../../vitest.config.ts --project unit packages/testkit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "catalog:",
    "@hocuspocus/provider": "catalog:",
    "@iridium/api-client": "workspace:*",
    "@iridium/collab-client": "workspace:*",
    "@iridium/contracts": "workspace:*",
    "@iridium/crdt": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@testcontainers/mysql": "catalog:",
    "@testcontainers/toxiproxy": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "fast-check": "catalog:",
    "kysely": "catalog:",
    "msw": "catalog:",
    "testcontainers": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@iridium/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "vitest": "catalog:"
  }
}
