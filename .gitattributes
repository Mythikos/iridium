* text=auto eol=lf

# Binary assets: never normalised, never diffed as text
*.png -text
*.jpg -text
*.webp -text
*.ico -text
*.icns -text
*.zip -text
*.bin -text
*.woff2 -text

# Generated artefacts (pnpm gen): collapsed in review, drift-checked in CI
packages/contracts/openapi/openapi.json linguist-generated
packages/contracts/mcp/tools.schema.json linguist-generated
packages/api-client/src/generated/** linguist-generated
# Line-ending fixtures are test data: CRLF, CR-only, mixed and BOM files must survive checkout byte for byte
packages/testkit/src/fixtures/** -text
apps/server/test/fixtures/** -text
