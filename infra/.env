# Compose interpolation variables for infra/compose.yaml and infra/compose.prod.yaml
# (11-operations-and-deployment.md, "infra/compose.prod.yaml"). `docker compose` loads this file
# from the project directory — the directory of the compose file — and uses it only to expand
# ${...}. It is never injected into a container, so none of these names reaches the server's
# EnvSchema and the fatal unknown-IRIDIUM_-key rule (ARCH-25) is not tripped by them.
#
# Deployment shape lives here. Runtime configuration lives in ./iridium.env and ./secrets/*, and
# docs/ops/deployment.md says which value belongs in which file.
#
# These are pins, not preferences: `${CADDY_TAG:?pin missing}` in compose.prod.yaml turns a missing
# value into a startup failure rather than a silently floating tag. Renovate's docker manager
# maintains the image entries.

# Reverse proxy image, tag and digest together. A new digest comes from
#   docker buildx imagetools inspect caddy:2.11.4
# and is the digest of the multi-architecture index, so one pin serves amd64 and arm64.
CADDY_TAG=2.11.4
CADDY_DIGEST=sha256:13ba145cba2f3e28fa801994876e4c086d1b95d5aa2a520a734765ffb6b12017

# The MySQL line. Exactly one of the two supported values, patch and suffix included: 8.4.11 or
# 9.7.2-oraclelinux9. Both are required targets and CI runs the whole migration set against each.
#
# The committed value is the compatibility floor, because this file is also what the development
# compose file reads: a construct that works on 9.7 and not on 8.4 has to fail in the ordinary
# development loop, not in a lane someone has to go and read (12-milestones.md section 4.2 step 9).
# A deployment that wants the reference production line sets 9.7.2-oraclelinux9 here before its
# first boot — after the data directory exists the value is not a free choice any more, because the
# two lines do not share one datadir.
MYSQL_TAG=8.4.11

# The site Caddy serves, and which of the two shipped Caddyfiles it serves it with.
#
# The committed pair is the variant that boots on a clean machine with no DNS and no outbound
# network: Caddyfile.internal issues from Caddy's own local CA (`tls internal`) and `:443` accepts
# any host name. A site with a public origin sets IRIDIUM_SITE to its host name, switches
# IRIDIUM_CADDYFILE to Caddyfile, and sets IRIDIUM_ACME_EMAIL for the ACME account.
IRIDIUM_SITE=:443
IRIDIUM_CADDYFILE=Caddyfile.internal
# IRIDIUM_ACME_EMAIL=ops@example.com

# Object storage for the optional `s3` profile of infra/compose.yaml (development only; production
# sites bring their own S3-compatible endpoint). Apache-2.0. Digest of the multi-architecture index,
# resolved with `docker buildx imagetools inspect chrislusf/seaweedfs:4.46` (spike S8 policy).
SEAWEEDFS_TAG=4.46
SEAWEEDFS_DIGEST=sha256:08d516132314207d10c8e37cbffc1f32b147d870169688734cc61c6231625b62
