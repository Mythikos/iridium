{
  "name": "@iridium/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright 1.63 projects: setup, chromium (web), electron. Dev-only.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "e2e": "playwright test -c ../../playwright.config.ts --project=chromium",
    "e2e:electron": "playwright test -c ../../playwright.config.ts --project=electron"
  },
  "dependencies": {
    "@iridium/api-client": "workspace:*",
    "@iridium/contracts": "workspace:*",
    "@iridium/testkit": "workspace:*"
  },
  "devDependencies": {
    "@iridium/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:"
  }
}
