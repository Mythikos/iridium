{
  "ServerNoteMessage": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "persisted"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sv": {
            "type": "string",
            "minLength": 4,
            "maxLength": 87400,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "ds": {
            "$ref": "#/$defs/Sha256Hex"
          }
        },
        "required": [
          "v",
          "t",
          "seq",
          "sv",
          "ds"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "persist-failed"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "enum": [
              "db_unavailable",
              "db_error",
              "note_trashed",
              "too_large",
              "backpressure",
              "content_invalid"
            ]
          },
          "retryInMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "v",
          "t",
          "reason",
          "retryInMs"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "projected"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "v",
          "t",
          "seq"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "role"
          },
          "role": {
            "$ref": "#/$defs/Role"
          },
          "recovered": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "v",
          "t",
          "role"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "participants"
          },
          "users": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "colorHue": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 359
                },
                "role": {
                  "$ref": "#/$defs/Role"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "source",
                    "reading",
                    "split"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "colorHue",
                "role"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "v",
          "t",
          "users"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "closing"
          },
          "reason": {
            "type": "string",
            "enum": [
              "note-trashed",
              "vault-archived",
              "shutdown"
            ]
          },
          "graceMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        },
        "required": [
          "v",
          "t",
          "reason",
          "graceMs"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "checkpoint"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "revisionId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "create",
              "import",
              "checkpoint",
              "unload",
              "named",
              "pre_restore",
              "restore",
              "trash"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "v",
          "t",
          "seq",
          "revisionId",
          "kind"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "content-invalid"
          },
          "reason": {
            "type": "string",
            "enum": [
              "cr",
              "attributes"
            ]
          }
        },
        "required": [
          "v",
          "t",
          "reason"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "size-exceeded"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "v",
          "t",
          "size",
          "max"
        ],
        "additionalProperties": false
      }
    ],
    "$defs": {
      "Sha256Hex": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-f]{64}$"
      },
      "Role": {
        "type": "string",
        "enum": [
          "viewer",
          "editor",
          "manager"
        ]
      }
    }
  },
  "ServerVaultMessage": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "tree-changed"
          },
          "treeVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "changes": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nodeId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                },
                "parentId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "category",
                    "note"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "path": {
                  "type": "string",
                  "maxLength": 4096
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "created",
                    "renamed",
                    "moved",
                    "trashed",
                    "restored",
                    "purged"
                  ]
                },
                "version": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "nodeId",
                "parentId",
                "kind",
                "name",
                "path",
                "op",
                "version"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "v",
          "t",
          "treeVersion",
          "changes"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "member-changed"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/$defs/Role"
              },
              {
                "type": "null"
              }
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "colorHue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          }
        },
        "required": [
          "v",
          "t",
          "userId",
          "role",
          "displayName",
          "colorHue"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "vault-updated"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "v",
          "t",
          "version"
        ],
        "additionalProperties": false
      }
    ],
    "$defs": {
      "Role": {
        "type": "string",
        "enum": [
          "viewer",
          "editor",
          "manager"
        ]
      }
    }
  },
  "ClientNoteMessage": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "baseline"
          }
        },
        "required": [
          "v",
          "t"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "t": {
            "type": "string",
            "const": "flush"
          }
        },
        "required": [
          "v",
          "t"
        ],
        "additionalProperties": false
      }
    ]
  },
  "AwarenessState": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "user": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "cursor": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "anchor": {},
              "head": {}
            },
            "required": [
              "anchor",
              "head"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "mode": {
        "type": "string",
        "enum": [
          "source",
          "reading",
          "split"
        ]
      }
    },
    "required": [
      "user"
    ],
    "additionalProperties": false
  },
  "VaultAwarenessState": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "user": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "activeNoteId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "user"
    ],
    "additionalProperties": false
  }
}
